CLAUDE.local.md
worker/.wrangler/
worker/node_modules/
__pycache__/
growth/evals/runs/*-mock*/
# raw per-cell transcripts stay local (12 MB per full run); grades, manifest, results and the D1 join are committed
growth/evals/runs/*/openai/
growth/evals/runs/*/anthropic/
growth/evals/runs/*/gemini/
growth/evals/runs/*/xai/
growth/evals/runs/*/claude-code/
# full-page app screenshots ui.py saves per chat (~150 KB each); the iteration report copies the ones it shows
growth/evals/runs/*/*/*.jpg
growth/evals/runs/*/chatgpt/
# fetched page texts for the gap labels (focusgap/supply/compqual); results and labels are committed
growth/focus/focus-gap/packs.json
# fetched rival page text for the fast loop (growth/evals/fastloop.py); packs and scores are committed
growth/evals/runs/fastloop-cache/

# gapmine: raw autocomplete dumps are large and rebuildable
growth/gapmine/runs/*/suggest.json
!growth/gapmine/runs/pool/suggest.json
growth/evals/runs/*/page/shots/

# wrangler local cache (root)
.wrangler/

# screenshots saved straight into a run folder or a report folder (the rule above covers only one level deeper)
growth/evals/runs/**/*.jpg
growth/focus/open-queries/**/*.jpg
growth/focus/top-bottom/**/*.jpg
# D1 exports that carry visitor addresses and order ids stay local; re-read them from D1
growth/focus/offers/data/clickers.json
growth/focus/offers/data/sales.json
# entity paperwork notes stay local
growth/llc/
