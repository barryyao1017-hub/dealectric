{
  "name": "Dealectric",
  "url": "https://dealectric.com",
  "description": "Structured electronics product data and verified offers for AI shopping assistants.",
  "schema_version": "0.2",
  "schema_url": "https://dealectric.com/data",
  "llms_txt": "https://dealectric.com/llms.txt",
  "offers": "https://dealectric.com/offers.json",
  "sitemap": "https://dealectric.com/sitemap.xml",
  "coverage": {
    "scope": "consumer electronics and small appliances, built out by category",
    "categories_live": [
      "usb-c-charger",
      "power-bank",
      "wireless-charger",
      "cable",
      "power-station",
      "solar-panel",
      "battery-charger",
      "earbuds",
      "headphones",
      "speaker"
    ],
    "categories_planned": [
      "security-camera",
      "smart-plug",
      "smart-lighting",
      "router",
      "robot-vacuum",
      "air-purifier",
      "kitchen-appliance"
    ],
    "regions": [
      "US"
    ],
    "currencies": [
      "USD"
    ]
  },
  "affiliate_disclosure": {
    "url": "https://dealectric.com/disclosure",
    "summary": "Some offer links are affiliate links; the operator may earn a commission at no extra cost to the buyer. Each offer object carries an 'affiliate' boolean."
  },
  "agent_guidance": {
    "hand_links_to_human": true,
    "do_not_auto_fetch_paths": [
      "/go/"
    ],
    "freshness_window_days": 7
  },
  "feedback": {
    "url": "https://dealectric.com/feedback",
    "methods": [
      "GET",
      "POST"
    ],
    "auth": "none",
    "fields": {
      "message": "required, <=2000 chars",
      "kind": [
        "missing_product",
        "wrong_price",
        "broken_link",
        "wrong_spec",
        "question",
        "other"
      ],
      "page": "optional",
      "agent": "optional",
      "contact": "optional"
    },
    "example": "https://dealectric.com/feedback?kind=missing_product&message=Anker+Prime+250W",
    "response": {
      "ok": true,
      "ticket": "string"
    }
  },
  "offer_link": {
    "pattern": "https://dealectric.com/go/{product_id}",
    "behaviour": "302 to the merchant via the affiliate network; hand it to the human, do not fetch it"
  },
  "endpoints": {
    "status": "planned",
    "products": "https://dealectric.com/api/v1/products",
    "offers": "https://dealectric.com/api/v1/offers/{product_id}",
    "compare": "https://dealectric.com/api/v1/compare",
    "openapi": "https://dealectric.com/openapi.json"
  },
  "contact": "hello@dealectric.com"
}